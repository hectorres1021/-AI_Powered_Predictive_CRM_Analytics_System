# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ilead_ams
DB_SSL=false

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Super Admin Configuration
SUPER_ADMIN_EMAIL=hector.torres@i-leadusa.org
SUPER_ADMIN_PIN_HASH=$2a$10$your-bcrypt-hashed-pin-071676-here
SUPER_ADMIN_PIN_PLAIN=071676

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://98.94.220.9

# Email Configuration (Nodemailer)
# Option 1: SMTP (Gmail, Office 365, or custom)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hector.torres@i-leadusa.org
SMTP_PASS=your-app-password-here
SMTP_FROM=I-LEAD AMS <noreply@i-leadusa.org>

# Option 2: SendGrid (uncomment to use instead of SMTP)
# SENDGRID_API_KEY=your-sendgrid-api-key-here

# SMS Configuration (Clearstream)
# Get API key from: https://api.getclearstream.com/
# Important: Regenerate key - previous key was exposed in chat
CLEARSTREAM_API_KEY=your-clearstream-api-key-here
CLEARSTREAM_ENDPOINT=https://api.getclearstream.com/v1/texts

# Document Storage Configuration
# Option 1: Local storage (default)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Option 2: AWS S3 (uncomment to use instead of local)
# STORAGE_TYPE=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=ilead-ams-docs
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# File Upload Limits
MAX_FILE_SIZE=52428800

# Google Sheets Configuration
GOOGLE_SHEETS_API_KEY=your-google-sheets-api-key-here
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here

# Make.com Configuration
MAKE_WEBHOOK_URL=https://hook.us2.make.com/o23utkbnivlz57azfnzvppg11vatqsco

# AWS S3 Configuration (for document storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET=ilead-ams-docs
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-key-here
SESSION_MAX_AGE=86400000
